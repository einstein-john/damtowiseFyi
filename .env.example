# ── Runtime ────────────────────────────────────────────────────────────────
# development | test | production (default: development)
NODE_ENV=development
# Port the server listens on (default: 8787)
PORT=8787

# ── Neon (Postgres) ────────────────────────────────────────────────────────
# Pooled connection string: used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection string: used ONLY by drizzle-kit (npm run db:migrate / db:generate).
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# ── Neon Auth ──────────────────────────────────────────────────────────────
# Your Neon Auth instance URL (required).
NEON_AUTH_URL=https://auth-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.auth.neon.tech
# Neon signs access tokens with `iss` set to the ORIGIN of the URL above
# (scheme + host, no path). Only set this if your issuer really differs.
# NEON_AUTH_JWT_ISSUER=https://auth-xxxxxxxx.auth.neon.tech
# Neon also sets `aud` to that same origin. Leave unset unless you know your
# tokens carry something else — jose only checks `aud` when a value is configured.
# NEON_AUTH_JWT_AUDIENCE=https://auth-xxxxxxxx.auth.neon.tech
# Email address allowed during sign-up when ALLOW_SIGNUP=true (required).
ADMIN_EMAIL=you@damtowise.xyz
# Comma-separated Neon Auth user ids for /admin/* access. Get yours with:
#   SELECT id, email FROM neon_auth.user;
ADMIN_USER_IDS=
# Temporary sign-up gate. Set true only during initial admin bootstrap.
ALLOW_SIGNUP=false

# ── Origins ────────────────────────────────────────────────────────────────
# Used for CORS and absolute URLs (defaults shown).
SITE_ORIGIN=https://damtowise.xyz
API_PUBLIC_ORIGIN=https://api.damtowise.xyz

# ── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder prefix for all uploads (default: fyi)
CLOUDINARY_FOLDER=fyi

# ── Vercel ─────────────────────────────────────────────────────────────────
# Deploy hook URL. Never expose this to the browser.
VERCEL_DEPLOY_HOOK_URL=

# ── Tuning ─────────────────────────────────────────────────────────────────
# Milliseconds triggers are coalesced into a single build (default: 60000).
DEPLOY_DEBOUNCE_MS=60000
# Maximum accepted age of a webhook signature in seconds (default: 300, min: 30).
WEBHOOK_SIGNATURE_MAX_AGE_SECONDS=300
# Rate-limit window in milliseconds (default: 60000, min: 1000).
RATE_LIMIT_WINDOW_MS=60000
# Requests per window per client address (defaults: 120 read, 20 write, 10 webhook).
ADMIN_READ_RATE_LIMIT=120
ADMIN_WRITE_RATE_LIMIT=20
WEBHOOK_RATE_LIMIT=10
# Enable the in-memory publish scheduler (default: true).
SCHEDULER_ENABLED=true

# Directory containing the bundled TTF files used for OG images (default: assets/fonts).
OG_FONTS_DIR=assets/fonts