# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787

# ── Neon (Postgres) ────────────────────────────────────────────────────────
# Pooled connection string: used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection string: used ONLY by drizzle-kit (pnpm db:migrate / db:generate).
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# ── Neon Auth ──────────────────────────────────────────────────────────────
NEON_AUTH_URL=https://auth-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.auth.neon.tech
# Only if your tokens carry a different issuer / audience than the defaults.
# NEON_AUTH_JWT_ISSUER=https://auth-xxxxxxxx.auth.neon.tech
# NEON_AUTH_JWT_AUDIENCE=damtowise
ADMIN_EMAIL=you@damtowise.xyz
# Comma-separated Neon Auth user ids. Get yours with:
#   SELECT id, email FROM neon_auth.user;
ADMIN_USER_IDS=
# Temporary sign-up gate. See README "Bootstrapping the admin account".
ALLOW_SIGNUP=false

# ── Origins ────────────────────────────────────────────────────────────────
SITE_ORIGIN=https://damtowise.xyz
API_PUBLIC_ORIGIN=https://api.damtowise.xyz

# ── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fyi

# ── Vercel ─────────────────────────────────────────────────────────────────
# Deploy hook URL. Never expose this to the browser.
VERCEL_DEPLOY_HOOK_URL=

# ── Tuning ─────────────────────────────────────────────────────────────────
# Milliseconds triggers are coalesced into a single build.
DEPLOY_DEBOUNCE_MS=60000
# Maximum accepted age of a webhook signature.
WEBHOOK_SIGNATURE_MAX_AGE_SECONDS=300
RATE_LIMIT_WINDOW_MS=60000
ADMIN_READ_RATE_LIMIT=120
ADMIN_WRITE_RATE_LIMIT=20
WEBHOOK_RATE_LIMIT=10
SCHEDULER_ENABLED=true

# Directory containing the bundled TTF files used for OG images.
OG_FONTS_DIR=assets/fonts